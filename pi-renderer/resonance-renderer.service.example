[Unit]
Description=re:sonance trusted openDAW renderer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=resonance
WorkingDirectory=/opt/resonance/pi-renderer
EnvironmentFile=/etc/resonance/pi-renderer.env
ExecStart=/usr/bin/node /opt/resonance/pi-renderer/server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/resonance-renderer

[Install]
WantedBy=multi-user.target
