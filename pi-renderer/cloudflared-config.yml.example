# Copy to /etc/cloudflared/config.yml on the Raspberry Pi.
# Create the tunnel with `cloudflared tunnel create resonance-renderer` first.
tunnel: REPLACE_WITH_TUNNEL_UUID
credentials-file: /etc/cloudflared/REPLACE_WITH_TUNNEL_UUID.json

ingress:
  - hostname: renderer.example.com
    service: http://127.0.0.1:8790
    originRequest:
      connectTimeout: 10s
      noHappyEyeballs: true
  - service: http_status:404
